# Server
PORT=8080
APP_ENV=development

# Database (Supabase - Connection Pooler for app)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require

# Database (Supabase - Direct for migrations)
MIGRATE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
MIGRATE_DB_PORT=5432

# Supabase Auth
# Ambil dari: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Google Auth
# Default: https://www.googleapis.com/oauth2/v3/certs
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
